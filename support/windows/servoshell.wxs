<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!-- Stillwater setup: installs per-user into %LOCALAPPDATA%\Programs\Stillwater (no admin prompt).
       The auto-updater runs this with /passive. -->
  <Bundle Name="Stillwater"
          Version="0.3.1"
          Manufacturer="Stillwater contributors"
          AboutUrl="https://github.com/WhoaThatCombo/stillwater"
          UpdateUrl="https://github.com/WhoaThatCombo/stillwater/releases"
          UpgradeCode="b6f826c9-cff2-43c0-9eb7-58c2c0ce4726">

    <Variable Name="InstallFolder"
          Type="formatted"
          Value="[LocalAppDataFolder]Programs\Stillwater"
          bal:Overridable="yes" />

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl="https://www.mozilla.org/en-US/MPL/2.0/"
        Theme="hyperlinkLicense"
        LogoFile="stillwater_64.png"
        LaunchTarget="[InstallFolder]\Stillwater.exe"
        />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage
          SourceFile="Installer.msi"
          Compressed="yes"
          DisplayName="Stillwater">
        <MsiProperty Name="INSTALLDIR" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>